{
  "name": "hippos-home-assistant-toolbox",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog:check": "node tools/blueprint-catalog/cli.ts check",
    "catalog:sync": "node tools/blueprint-catalog/cli.ts sync",
    "camera-overlay:render": "node tools/camera-overlay/render.ts",
    "changeset": "changeset",
    "lint": "eslint . && pnpm catalog:check",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0 && pnpm catalog:check",
    "test": "pnpm test:unit && pnpm test:ha",
    "test:ha": "vitest run --config test/home-assistant/vitest.config.ts",
    "test:ha:blueprint-loading": "vitest run --config test/home-assistant/blueprint-loading/vitest.config.ts",
    "test:ha:hippos-toolbox-integration": "vitest run --config test/home-assistant/hippos-toolbox-integration/vitest.config.ts",
    "test:ha:runtime": "vitest run --config test/home-assistant/runtime/vitest.config.ts",
    "test:unit": "vitest run --config test/unit/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm catalog:sync && pnpm lint:strict && pnpm catalog:check --base origin/main && pnpm typecheck && pnpm test:unit && pnpm validate:hassfest && pnpm validate:hacs && pnpm test:ha",
    "validate:hacs": "node tools/validation/cli.ts hacs",
    "validate:hassfest": "node tools/validation/cli.ts hassfest",
    "release:publish": "changeset publish",
    "release:version": "changeset version && node tools/release/sync-version.ts",
    "frontend:build": "node tools/frontend/build.ts",
    "frontend:check": "node tools/frontend/build.ts --check"
  },
  "packageManager": "pnpm@10.6.1",
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-yml": "^3.4.0",
    "globals": "^17.6.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.3",
    "sharp": "^0.34.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "yaml-eslint-parser": "^2.0.0"
  }
}
